{
  "name": "nova",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --cwd apps/api --watch src/index.ts",
    "dev:playground": "bun --cwd apps/playground run dev",
    "dev": "bun run --parallel dev:api dev:playground",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "dotenv": "^18.0.7",
    "hono": "^4.13.13",
    "zod": "^4.6.6"
  }
}